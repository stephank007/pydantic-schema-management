    "InterfaceName": {
      "$anchor": "InterfaceName",
      "type": "string",
      "pattern": "^Z[A-Z0-9_]{3,40}$",
      "minLength": 4,
      "maxLength": 41,
      "description": "SAP WMS interface routing key. Always begins with 'Z' (custom namespace), uppercase alphanumeric + underscore. Strictly pattern-checked — unknown interfaces are hard-rejected. Analogous to message_type in the generic firewall.",
      "examples": [
        "ZWMS_WMS_PULL_PUSH_UNIT",
        "ZWMS_WMS_RETURN_UNIT"
      ]
    },
    "MessageId": {
      "$anchor": "MessageId",
      "type": "string",
      "pattern": "^[0-9]{16}$",
      "minLength": 16,
      "maxLength": 16,
      "description": "Unique 16-digit zero-padded message identifier assigned by the sending system.",
      "examples": [
        "0000002243643973",
        "0000000000000001"
      ]
    },
    "PlantCode": {
      "$anchor": "PlantCode",
      "type": "string",
      "pattern": "^[0-9]{4}$",
      "minLength": 4,
      "maxLength": 4,
      "description": "SAP 4-digit numeric plant code. Infrastructure primitive — owned by the infra/master-data team. Declared once here; $ref'd by any payload field that carries a plant code (SUPPLYING_PLANT, RECEIVING_PLANT, TRANSIT_DOCKING_PLANT).",
      "examples": [
        "6300",
        "0010",
        "1000"
      ]
    },
    "ConsigneeCode": {
      "$anchor": "ConsigneeCode",
      "type": "string",
      "pattern": "^[A-Z0-9]{2,10}$",
      "minLength": 2,
      "maxLength": 10,
      "description": "Recipient/consignee short code. Uppercase alphanumeric, 2–10 chars. Infrastructure-level recipient identity — not a business-domain customer identifier.",
      "examples": [
        "ATAL",
        "MAIN",
        "WH01"
      ]
    },
    "SapDate": {
      "$anchor": "SapDate",
      "type": "string",
      "pattern": "^[0-9]{8}$",
      "minLength": 8,
      "maxLength": 8,
      "description": "SAP compact date format YYYYMMDD. Used for all date fields across envelope and payload. Declared once here; $ref'd by payload date fields (DELIVERY_DATE etc.).",
      "examples": [
        "20240915",
        "20241010"
      ]
    },
    "SapTime": {
      "$anchor": "SapTime",
      "type": "string",
      "pattern": "^[0-9]{6}$",
      "minLength": 6,
      "maxLength": 6,
      "description": "SAP compact time format HHMMSS (24-hour). Used in envelope timestamp; payload systems may $ref for time fields.",
      "examples": [
        "160656",
        "083000",
        "235959"
      ]
    },
    "OpaqueDocHeader": {
      "$anchor": "OpaqueDocHeader",
      "type": "object",
